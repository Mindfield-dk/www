// See https://aka.ms/devcontainer.json for the format.
{
	"name": "www",
	// Node 24 on Debian trixie, pinned so a rebuild doesn't silently move to a new Debian release. package.json engines
	// allow any 24.x >= 24.15.0 (CI and .nvmrc use 24.15.0). Includes git and jq.
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24-trixie",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"mounts": [
		// Keep Claude Code's login, settings and project memory across container rebuilds.
		"source=www-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
		// Keep node_modules in a volume instead of the host bind mount; on macOS this makes npm ci, nuxt dev and
		// builds much faster. The host's own node_modules folder is hidden inside the container.
		"source=www-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude",
		// Skip Nuxt's interactive telemetry prompt.
		"NUXT_TELEMETRY_DISABLED": "1"
	},
	// Volumes are created root-owned, so hand them to the node user first. Playwright is installed globally with
	// Chromium and its system libraries, so the app can be driven headlessly.
	"postCreateCommand": "sudo chown -R node:node /home/node/.claude \"${containerWorkspaceFolder}/node_modules\" && npm install --global @anthropic-ai/claude-code playwright && playwright install --with-deps chromium && npm ci",
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Nuxt dev server",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Vue.volar",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss",
				"DavidAnson.vscode-markdownlint",
				"usernamehw.errorlens",
				"medo64.render-crlf"
			]
		}
	}
}
