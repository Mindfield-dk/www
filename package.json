{
    "name": "nuxt-app",
    "private": true,
    "engines": {
        "node": ">=24.11.0 <25"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lintfix": "eslint . --fix",
        "mdlint": "markdownlint '**/*.md' --ignore node_modules --ignore .nuxt",
        "check": "npm run lint && npm run mdlint && npx nuxi typecheck && npm run build"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260827.1",
        "@nuxt/devtools": "^3.4.2",
        "@nuxt/eslint": "^1.17.0",
        "@types/node": "^26.2.0",
        "eslint": "^10.9.0",
        "markdownlint-cli": "^0.49.1",
        "nuxt": "^4.5.2",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@nuxt/ui": "^4.11.0",
        "@octokit/rest": "^22.0.1",
        "unsplash-js": "^8.0.1"
    }
}
