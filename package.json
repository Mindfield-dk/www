        "eslint": "^10.12.0",
        "markdownlint-cli": "^0.49.1",
        "nitropack": "^2.13.4",
        "nuxt": "^4.6.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.12"
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.142",
        "@iconify-json/simple-icons": "^1.2.99",
        "@nuxt/ui": "^4.11.3",
        "@octokit/rest": "^22.0.1",
        "unsplash-js": "^8.0.1"
