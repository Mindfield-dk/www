{
    "name": "nuxt-app",
    "private": true,
    "engines": {
        "node": ">=24.11.0 <25"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lintfix": "eslint . --fix",
        "mdlint": "markdownlint '**/*.md' --ignore node_modules --ignore .nuxt",
        "check": "npm run lint && npm run mdlint && npx nuxi typecheck && npm run build"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260616.1",
        "@nuxt/devtools": "^3.2.4",
        "@nuxt/eslint": "^1.16.0",
        "@types/node": "^26.0.1",
        "eslint": "^10.5.0",
        "markdownlint-cli": "^0.48.0",
        "nuxt": "^4.4.8",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@nuxt/ui": "^4.8.2",
        "@octokit/rest": "^22.0.1",
        "unsplash-js": "^7.0.20"
    }
}
