{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.15.0 <25"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lintfix": "eslint . --fix",
